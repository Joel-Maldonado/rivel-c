    </dict>
    <key>function-declaration</key>
    <dict>
      <key>name</key>
      <string>meta.function.rivel</string>
      <key>begin</key>
      <string>\b(func)\b(?:[ \t]+([A-Za-z_][A-Za-z0-9_]*))?</string>
      <key>beginCaptures</key>
      <dict>
        <key>1</key>
        <dict>
          <key>name</key>
          <string>storage.type.function.rivel</string>
        </dict>
        <key>2</key>
        <dict>
          <key>name</key>
          <string>entity.name.function.rivel</string>
        </dict>
      </dict>
      <key>end</key>
      <string>(?=[{;])|$</string>
      <key>patterns</key>
      <array>
        <dict>
          <key>include</key>
          <string>#comments</string>
        </dict>
        <dict>
          <key>include</key>
          <string>#parameters</string>
        </dict>
        <dict>
          <key>include</key>
          <string>#return-type</string>
        </dict>
        <dict>
          <key>name</key>
          <string>entity.name.function.rivel</string>
          <key>match</key>
          <string>\b[A-Za-z_][A-Za-z0-9_]*\b</string>
        </dict>
      </array>
    </dict>
    <key>parameters</key>
    <dict>
      <key>name</key>
      <string>meta.function.parameters.rivel</string>
      <key>begin</key>
      <string>\(</string>
      <key>beginCaptures</key>
      <dict>
        <key>0</key>
        <dict>
          <key>name</key>
          <string>punctuation.section.parameters.begin.rivel</string>
        </dict>
      </dict>
      <key>end</key>
      <string>\)|(?=[{;])</string>
      <key>endCaptures</key>
      <dict>
        <key>0</key>
        <dict>
          <key>name</key>
          <string>punctuation.section.parameters.end.rivel</string>
        </dict>
      </dict>
      <key>patterns</key>
      <array>
        <dict>
          <key>include</key>
          <string>#comments</string>
        </dict>
        <dict>
          <key>name</key>
          <string>meta.type.annotation.rivel</string>
          <key>begin</key>
          <string>:(?![=])</string>
          <key>beginCaptures</key>
          <dict>
            <key>0</key>
            <dict>
              <key>name</key>
              <string>punctuation.separator.type.rivel</string>
            </dict>
          </dict>
          <key>end</key>
          <string>(?=[,)=;{}])</string>
          <key>patterns</key>
          <array>
            <dict>
              <key>include</key>
              <string>#type-expression</string>
            </dict>
          </array>
        </dict>
        <dict>
          <key>name</key>
          <string>variable.language.self.rivel</string>
          <key>match</key>
          <string>\bself\b</string>
        </dict>
        <dict>
          <key>name</key>
          <string>variable.parameter.rivel</string>
          <key>match</key>
          <string>\b[A-Za-z_][A-Za-z0-9_]*\b</string>
        </dict>
        <dict>
          <key>include</key>
          <string>#punctuation</string>
        </dict>
      </array>
    </dict>
    <key>struct-declaration</key>
    <dict>
      <key>match</key>
      <string>\b(struct)\b(?:[ \t]+([A-Za-z_][A-Za-z0-9_]*))?</string>
      <key>captures</key>
      <dict>
        <key>1</key>
        <dict>
          <key>name</key>
          <string>storage.type.struct.rivel</string>
        </dict>
        <key>2</key>
        <dict>
          <key>name</key>
          <string>entity.name.type.struct.rivel</string>
        </dict>
      </dict>
    </dict>
    <key>keywords</key>
    <dict>
      <key>patterns</key>
      <array>
        <dict>
          <key>name</key>
          <string>keyword.control.rivel</string>
          <key>match</key>
          <string>\b(?:if|else|while|for|in|break|continue|return)\b</string>
        </dict>
        <dict>
          <key>name</key>
          <string>keyword.other.reserved.rivel</string>
          <key>match</key>
          <string>\b(?:enum|match|import|as|const|pub|type|is)\b</string>
        </dict>
        <dict>
          <key>name</key>
          <string>variable.language.self.rivel</string>
          <key>match</key>
          <string>\bself\b</string>
        </dict>
        <dict>
          <key>name</key>
          <string>constant.language.boolean.rivel</string>
          <key>match</key>
          <string>\b(?:true|false)\b</string>
        </dict>
        <dict>
          <key>name</key>
          <string>constant.language.null.rivel</string>
          <key>match</key>
          <string>\bnull\b</string>
        </dict>
      </array>
    </dict>
    <key>numbers</key>
    <dict>
      <key>patterns</key>
      <array>
        <dict>
          <key>name</key>
          <string>constant.numeric.integer.hexadecimal.rivel</string>
          <key>match</key>
          <string>\b0x[0-9A-Fa-f_]+\b</string>
        </dict>
        <dict>
          <key>name</key>
          <string>constant.numeric.integer.octal.rivel</string>
          <key>match</key>
          <string>\b0o[0-7_]+\b</string>
        </dict>
        <dict>
          <key>name</key>
          <string>constant.numeric.integer.binary.rivel</string>
          <key>match</key>
          <string>\b0b[01_]+\b</string>
        </dict>
        <dict>
          <key>name</key>
          <string>constant.numeric.float.rivel</string>
          <key>match</key>
          <string>\b[0-9][0-9_]*(?:\.[0-9][0-9_]*(?:[eE][+-]?[0-9]+)?|[eE][+-]?[0-9]+)\b</string>
        </dict>
        <dict>
          <key>name</key>
          <string>constant.numeric.integer.decimal.rivel</string>
          <key>match</key>
          <string>\b[0-9][0-9_]*\b</string>
        </dict>
      </array>
    </dict>
    <key>types</key>
    <dict>
      <key>patterns</key>
      <array>
        <dict>
          <key>include</key>
          <string>#list-type</string>
        </dict>
        <dict>
          <key>name</key>
          <string>storage.type.builtin.rivel</string>
          <key>match</key>
          <string>\b(?:int|float|bool|str|list|void)\b</string>
        </dict>
        <dict>
          <key>match</key>
          <string>\b([A-Za-z_][A-Za-z0-9_]*)(\?)(?!\?)</string>
          <key>captures</key>
          <dict>
            <key>1</key>
            <dict>
              <key>name</key>
              <string>entity.name.type.rivel</string>
            </dict>
            <key>2</key>
            <dict>
              <key>name</key>
              <string>keyword.operator.optional.rivel</string>
            </dict>
          </dict>
        </dict>
      </array>
    </dict>
    <key>type-expression</key>
    <dict>
      <key>patterns</key>
      <array>
        <dict>
          <key>include</key>
          <string>#comments</string>
        </dict>
        <dict>
          <key>include</key>
          <string>#types</string>
        </dict>
        <dict>
          <key>name</key>
          <string>entity.name.type.rivel</string>
          <key>match</key>
          <string>\b[A-Za-z_][A-Za-z0-9_]*\b</string>
        </dict>
        <dict>
          <key>name</key>
          <string>keyword.operator.optional.rivel</string>
          <key>match</key>
          <string>\?(?!\?)</string>
        </dict>
      </array>
    </dict>
    <key>list-type</key>
    <dict>
      <key>name</key>
      <string>meta.type.list.rivel</string>
      <key>begin</key>
      <string>\b(list)[ \t]*(\[)</string>
      <key>beginCaptures</key>
      <dict>
        <key>1</key>
        <dict>
          <key>name</key>
          <string>storage.type.builtin.rivel</string>
        </dict>
        <key>2</key>
        <dict>
          <key>name</key>
          <string>punctuation.section.type-arguments.begin.rivel</string>
        </dict>
      </dict>
      <key>end</key>
      <string>\]|(?=[;{}()=])</string>
      <key>endCaptures</key>
      <dict>
        <key>0</key>
        <dict>
          <key>name</key>
          <string>punctuation.section.type-arguments.end.rivel</string>
        </dict>
      </dict>
      <key>patterns</key>
      <array>
        <dict>
          <key>include</key>
          <string>#type-expression</string>
        </dict>
      </array>
    </dict>
    <key>return-type</key>
    <dict>
      <key>name</key>
      <string>meta.type.return.rivel</string>
      <key>begin</key>
      <string>-&gt;</string>
      <key>beginCaptures</key>
      <dict>
        <key>0</key>
        <dict>
          <key>name</key>
          <string>keyword.operator.arrow.rivel</string>
        </dict>
      </dict>
      <key>end</key>
      <string>(?=[{;=,)}])|$</string>
      <key>patterns</key>
      <array>
        <dict>
          <key>include</key>
          <string>#type-expression</string>
        </dict>
      </array>
    </dict>
    <key>annotated-type</key>
    <dict>
      <key>comment</key>
      <string>The = or ; terminator distinguishes declarations from constructor argument labels.</string>
      <key>begin</key>
      <string>(:)(?![=])(?=[ \t]*[A-Za-z_][A-Za-z0-9_]*[ \t]*(?:[=;]))</string>
      <key>beginCaptures</key>
      <dict>
        <key>1</key>
        <dict>
          <key>name</key>
          <string>punctuation.separator.type.rivel</string>
        </dict>
      </dict>
      <key>end</key>
      <string>(?=[=;])|$</string>
      <key>patterns</key>
      <array>
        <dict>
          <key>include</key>
          <string>#type-expression</string>
        </dict>
      </array>
    </dict>
    <key>calls</key>
    <dict>
      <key>patterns</key>
      <array>
        <dict>
          <key>match</key>
          <string>(\.)([ \t]*)(contains|starts_with|ends_with|find|split|join|trim|upper|lower|replace|repeat|append|pop|insert|remove_at|clear|index_of)\b(?=[ \t]*\()</string>
          <key>captures</key>
          <dict>
            <key>1</key>
            <dict>
              <key>name</key>
              <string>punctuation.accessor.rivel</string>
            </dict>
            <key>3</key>
            <dict>
              <key>name</key>
              <string>support.function.builtin.rivel</string>
            </dict>
          </dict>
        </dict>
        <dict>
          <key>match</key>
          <string>(\.)([ \t]*)([A-Za-z_][A-Za-z0-9_]*)\b(?=[ \t]*\()</string>
          <key>captures</key>
          <dict>
            <key>1</key>
            <dict>
              <key>name</key>
              <string>punctuation.accessor.rivel</string>
            </dict>
            <key>3</key>
            <dict>
              <key>name</key>
              <string>entity.name.function.rivel</string>
            </dict>
          </dict>
        </dict>
        <dict>
          <key>name</key>
          <string>support.function.builtin.rivel</string>
          <key>match</key>
          <string>\b(?:print|println|eprintln|len|ord|chr|panic|assert|exit|args|read_file|write_file|read_line|sqrt|abs|min|max|wrapping_add|wrapping_sub|wrapping_mul)\b(?=[ \t]*\()</string>
        </dict>
        <dict>
          <key>name</key>
          <string>entity.name.function.rivel</string>
          <key>match</key>
          <string>\b[A-Za-z_][A-Za-z0-9_]*\b(?=[ \t]*\()</string>
        </dict>
        <dict>
          <key>match</key>
          <string>(\.)([ \t]*)([A-Za-z_][A-Za-z0-9_]*)\b</string>
          <key>captures</key>
          <dict>
            <key>1</key>
            <dict>
              <key>name</key>
              <string>punctuation.accessor.rivel</string>
            </dict>
            <key>3</key>
            <dict>
              <key>name</key>
              <string>variable.other.member.rivel</string>
            </dict>
          </dict>
        </dict>
      </array>
    </dict>
    <key>operators</key>
    <dict>
      <key>patterns</key>
      <array>
        <dict>
          <key>name</key>
          <string>keyword.operator.range.rivel</string>
          <key>match</key>
          <string>\.\.=?</string>
        </dict>
        <dict>
          <key>name</key>
          <string>keyword.operator.null-coalescing.rivel</string>
          <key>match</key>
          <string>\?\?</string>
        </dict>
        <dict>
          <key>name</key>
          <string>keyword.operator.comparison.rivel</string>
          <key>match</key>
          <string>==|!=|&lt;=|&gt;=</string>
        </dict>
        <dict>
          <key>name</key>
          <string>keyword.operator.assignment.rivel</string>
          <key>match</key>
          <string>:=|[+*/%-]?=</string>
        </dict>
        <dict>
          <key>name</key>
          <string>keyword.operator.logical.rivel</string>
          <key>match</key>
          <string>&amp;&amp;|\|\||!</string>
        </dict>
        <dict>
          <key>name</key>
          <string>keyword.operator.bitwise.rivel</string>
          <key>match</key>
          <string>&lt;&lt;|&gt;&gt;|[&amp;|^~]</string>
        </dict>
        <dict>
          <key>name</key>
          <string>keyword.operator.comparison.rivel</string>
          <key>match</key>
          <string>[&lt;&gt;]</string>
        </dict>
        <dict>
          <key>name</key>
          <string>keyword.operator.arithmetic.rivel</string>
          <key>match</key>
          <string>[+*/%-]</string>
        </dict>
        <dict>
          <key>name</key>
          <string>keyword.operator.optional.rivel</string>
          <key>match</key>
          <string>\?</string>
        </dict>
