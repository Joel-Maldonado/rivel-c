        </dict>
      </array>
    </dict>
    <key>plain-string</key>
    <dict>
      <key>name</key>
      <string>string.quoted.double.rivel</string>
      <key>begin</key>
      <string>"</string>
      <key>beginCaptures</key>
      <dict>
        <key>0</key>
        <dict>
          <key>name</key>
          <string>punctuation.definition.string.begin.rivel</string>
        </dict>
      </dict>
      <key>end</key>
      <string>(")|$</string>
      <key>endCaptures</key>
      <dict>
        <key>1</key>
        <dict>
          <key>name</key>
          <string>punctuation.definition.string.end.rivel</string>
        </dict>
      </dict>
      <key>patterns</key>
      <array>
        <dict>
          <key>include</key>
          <string>#escapes</string>
        </dict>
      </array>
    </dict>
    <key>interpolated-string</key>
    <dict>
      <key>name</key>
      <string>string.quoted.double.interpolated.rivel</string>
      <key>begin</key>
      <string>\bf(")</string>
      <key>beginCaptures</key>
      <dict>
        <key>0</key>
        <dict>
          <key>name</key>
          <string>punctuation.definition.string.begin.rivel</string>
        </dict>
      </dict>
      <key>end</key>
      <string>(")|$</string>
      <key>endCaptures</key>
      <dict>
        <key>1</key>
        <dict>
          <key>name</key>
          <string>punctuation.definition.string.end.rivel</string>
        </dict>
      </dict>
      <key>patterns</key>
      <array>
        <dict>
          <key>include</key>
          <string>#escapes</string>
        </dict>
        <dict>
          <key>name</key>
          <string>constant.character.escape.brace.rivel</string>
          <key>match</key>
          <string>\{\{|\}\}</string>
        </dict>
        <dict>
          <key>include</key>
          <string>#interpolation</string>
        </dict>
        <dict>
          <key>name</key>
          <string>invalid.illegal.unescaped-brace.rivel</string>
          <key>match</key>
          <string>\}</string>
        </dict>
      </array>
    </dict>
    <key>escapes</key>
    <dict>
      <key>patterns</key>
      <array>
        <dict>
          <key>name</key>
          <string>constant.character.escape.rivel</string>
          <key>match</key>
          <string>\\(?:[\\"nrt0]|x[0-9A-Fa-f]{2}|u\{[0-9A-Fa-f]+\})</string>
        </dict>
        <dict>
          <key>name</key>
          <string>invalid.illegal.escape.rivel</string>
          <key>match</key>
          <string>\\.</string>
        </dict>
      </array>
    </dict>
