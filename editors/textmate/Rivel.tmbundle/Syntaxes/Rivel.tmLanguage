    <key>comments</key>
    <dict>
      <key>patterns</key>
      <array>
        <dict>
          <key>name</key>
          <string>comment.line.double-slash.rivel</string>
          <key>begin</key>
          <string>//</string>
          <key>beginCaptures</key>
          <dict>
            <key>0</key>
            <dict>
              <key>name</key>
              <string>punctuation.definition.comment.rivel</string>
            </dict>
          </dict>
          <key>end</key>
          <string>$</string>
        </dict>
        <dict>
          <key>include</key>
          <string>#block-comment</string>
        </dict>
      </array>
    </dict>
    <key>block-comment</key>
    <dict>
      <key>name</key>
      <string>comment.block.rivel</string>
      <key>begin</key>
      <string>/\*</string>
      <key>beginCaptures</key>
      <dict>
        <key>0</key>
        <dict>
          <key>name</key>
          <string>punctuation.definition.comment.begin.rivel</string>
        </dict>
      </dict>
      <key>end</key>
      <string>\*/</string>
      <key>endCaptures</key>
      <dict>
        <key>0</key>
        <dict>
          <key>name</key>
          <string>punctuation.definition.comment.end.rivel</string>
