{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Rivel",
  "scopeName": "source.rivel",
  "fileTypes": ["rivel", "rv"],
  "patterns": [
    { "include": "#code" }
  ],
  "repository": {
    "code": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#function-declaration" },
        { "include": "#struct-declaration" },
        { "include": "#keywords" },
        { "include": "#numbers" },
        { "include": "#types" },
        { "include": "#return-type" },
        { "include": "#annotated-type" },
        { "include": "#calls" },
        { "include": "#operators" },
        { "include": "#punctuation" },
        { "include": "#identifiers" }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.rivel",
          "begin": "//",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.rivel" }
          },
          "end": "$"
        },
        { "include": "#block-comment" }
      ]
    },
    "block-comment": {
      "name": "comment.block.rivel",
      "begin": "/\\*",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.comment.begin.rivel" }
      },
      "end": "\\*/",
      "endCaptures": {
        "0": { "name": "punctuation.definition.comment.end.rivel" }
      },
      "patterns": [
        { "include": "#block-comment" }
      ]
    },
    "strings": {
      "patterns": [
        { "include": "#interpolated-string" },
        { "include": "#plain-string" }
      ]
    },
    "plain-string": {
      "name": "string.quoted.double.rivel",
      "begin": "\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.rivel" }
      },
      "end": "(\")|$",
      "endCaptures": {
        "1": { "name": "punctuation.definition.string.end.rivel" }
      },
      "patterns": [
        { "include": "#escapes" }
      ]
    },
    "interpolated-string": {
      "name": "string.quoted.double.interpolated.rivel",
      "begin": "\\bf(\")",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.rivel" }
      },
      "end": "(\")|$",
      "endCaptures": {
        "1": { "name": "punctuation.definition.string.end.rivel" }
      },
      "patterns": [
        { "include": "#escapes" },
        {
          "name": "constant.character.escape.brace.rivel",
          "match": "\\{\\{|\\}\\}"
        },
        { "include": "#interpolation" },
        {
          "name": "invalid.illegal.unescaped-brace.rivel",
          "match": "\\}"
        }
      ]
    },
    "escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.rivel",
          "match": "\\\\(?:[\\\\\"nrt0]|x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]+\\})"
        },
        {
          "name": "invalid.illegal.escape.rivel",
          "match": "\\\\."
        }
      ]
    },
    "interpolation": {
      "name": "meta.embedded.expression.rivel",
      "begin": "\\{",
      "beginCaptures": {
        "0": { "name": "punctuation.section.interpolation.begin.rivel" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.section.interpolation.end.rivel" }
      },
      "patterns": [
        { "include": "#expression-braces" },
        { "include": "#code" }
      ]
    },
    "expression-braces": {
      "name": "meta.braces.rivel",
      "begin": "\\{",
      "beginCaptures": {
        "0": { "name": "punctuation.section.block.begin.rivel" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.section.block.end.rivel" }
      },
      "patterns": [
        { "include": "#expression-braces" },
        { "include": "#code" }
      ]
    },
    "function-declaration": {
      "name": "meta.function.rivel",
      "begin": "\\b(func)\\b(?:[ \\t]+([A-Za-z_][A-Za-z0-9_]*))?",
      "beginCaptures": {
        "1": { "name": "storage.type.function.rivel" },
        "2": { "name": "entity.name.function.rivel" }
      },
      "end": "(?=[{;])|$",
      "patterns": [
        { "include": "#comments" },
        { "include": "#parameters" },
        { "include": "#return-type" },
        {
          "name": "entity.name.function.rivel",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "parameters": {
      "name": "meta.function.parameters.rivel",
      "begin": "\\(",
      "beginCaptures": {
        "0": { "name": "punctuation.section.parameters.begin.rivel" }
      },
      "end": "\\)|(?=[{;])",
      "endCaptures": {
        "0": { "name": "punctuation.section.parameters.end.rivel" }
      },
      "patterns": [
        { "include": "#comments" },
        {
          "name": "meta.type.annotation.rivel",
          "begin": ":(?![=])",
          "beginCaptures": {
            "0": { "name": "punctuation.separator.type.rivel" }
          },
          "end": "(?=[,)=;{}])",
          "patterns": [
            { "include": "#type-expression" }
          ]
        },
        {
          "name": "variable.language.self.rivel",
          "match": "\\bself\\b"
        },
        {
          "name": "variable.parameter.rivel",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        },
        { "include": "#punctuation" }
      ]
    },
    "struct-declaration": {
      "match": "\\b(struct)\\b(?:[ \\t]+([A-Za-z_][A-Za-z0-9_]*))?",
      "captures": {
        "1": { "name": "storage.type.struct.rivel" },
        "2": { "name": "entity.name.type.struct.rivel" }
      }
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.rivel",
          "match": "\\b(?:if|else|while|for|in|break|continue|return)\\b"
        },
        {
          "name": "keyword.other.reserved.rivel",
          "match": "\\b(?:enum|match|import|as|const|pub|type|is)\\b"
        },
        {
          "name": "variable.language.self.rivel",
          "match": "\\bself\\b"
        },
        {
          "name": "constant.language.boolean.rivel",
          "match": "\\b(?:true|false)\\b"
        },
        {
          "name": "constant.language.null.rivel",
          "match": "\\bnull\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.hexadecimal.rivel",
          "match": "\\b0x[0-9A-Fa-f_]+\\b"
        },
        {
          "name": "constant.numeric.integer.octal.rivel",
          "match": "\\b0o[0-7_]+\\b"
        },
        {
          "name": "constant.numeric.integer.binary.rivel",
          "match": "\\b0b[01_]+\\b"
        },
        {
          "name": "constant.numeric.float.rivel",
          "match": "\\b[0-9][0-9_]*(?:\\.[0-9][0-9_]*(?:[eE][+-]?[0-9]+)?|[eE][+-]?[0-9]+)\\b"
        },
        {
          "name": "constant.numeric.integer.decimal.rivel",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        { "include": "#list-type" },
        {
          "name": "storage.type.builtin.rivel",
          "match": "\\b(?:int|float|bool|str|list|void)\\b"
        },
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(\\?)(?!\\?)",
          "captures": {
            "1": { "name": "entity.name.type.rivel" },
            "2": { "name": "keyword.operator.optional.rivel" }
          }
        }
      ]
    },
    "type-expression": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#types" },
        {
          "name": "entity.name.type.rivel",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        },
        {
          "name": "keyword.operator.optional.rivel",
          "match": "\\?(?!\\?)"
        }
      ]
    },
    "list-type": {
      "name": "meta.type.list.rivel",
      "begin": "\\b(list)[ \\t]*(\\[)",
      "beginCaptures": {
        "1": { "name": "storage.type.builtin.rivel" },
        "2": { "name": "punctuation.section.type-arguments.begin.rivel" }
      },
      "end": "\\]|(?=[;{}()=])",
      "endCaptures": {
        "0": { "name": "punctuation.section.type-arguments.end.rivel" }
      },
      "patterns": [
        { "include": "#type-expression" }
      ]
    },
    "return-type": {
      "name": "meta.type.return.rivel",
      "begin": "->",
      "beginCaptures": {
        "0": { "name": "keyword.operator.arrow.rivel" }
      },
      "end": "(?=[{;=,)}])|$",
      "patterns": [
        { "include": "#type-expression" }
      ]
    },
    "annotated-type": {
      "comment": "The = or ; terminator distinguishes declarations from constructor argument labels.",
      "begin": "(:)(?![=])(?=[ \\t]*[A-Za-z_][A-Za-z0-9_]*[ \\t]*(?:[=;]))",
      "beginCaptures": {
        "1": { "name": "punctuation.separator.type.rivel" }
      },
      "end": "(?=[=;])|$",
      "patterns": [
        { "include": "#type-expression" }
      ]
    },
    "calls": {
      "patterns": [
        {
          "match": "(\\.)([ \\t]*)(contains|starts_with|ends_with|find|split|join|trim|upper|lower|replace|repeat|append|pop|insert|remove_at|clear|index_of)\\b(?=[ \\t]*\\()",
          "captures": {
            "1": { "name": "punctuation.accessor.rivel" },
            "3": { "name": "support.function.builtin.rivel" }
          }
        },
        {
          "match": "(\\.)([ \\t]*)([A-Za-z_][A-Za-z0-9_]*)\\b(?=[ \\t]*\\()",
          "captures": {
            "1": { "name": "punctuation.accessor.rivel" },
            "3": { "name": "entity.name.function.rivel" }
          }
        },
        {
          "name": "support.function.builtin.rivel",
          "match": "\\b(?:print|println|eprintln|len|ord|chr|panic|assert|exit|args|read_file|write_file|read_line|sqrt|abs|min|max|wrapping_add|wrapping_sub|wrapping_mul)\\b(?=[ \\t]*\\()"
        },
        {
          "name": "entity.name.function.rivel",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=[ \\t]*\\()"
        },
        {
          "match": "(\\.)([ \\t]*)([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "punctuation.accessor.rivel" },
            "3": { "name": "variable.other.member.rivel" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.range.rivel", "match": "\\.\\.=?" },
        { "name": "keyword.operator.null-coalescing.rivel", "match": "\\?\\?" },
        { "name": "keyword.operator.comparison.rivel", "match": "==|!=|<=|>=" },
        { "name": "keyword.operator.assignment.rivel", "match": ":=|[+*/%-]?=" },
        { "name": "keyword.operator.logical.rivel", "match": "&&|\\|\\||!" },
        { "name": "keyword.operator.bitwise.rivel", "match": "<<|>>|[&|^~]" },
        { "name": "keyword.operator.comparison.rivel", "match": "[<>]" },
        { "name": "keyword.operator.arithmetic.rivel", "match": "[+*/%-]" },
        { "name": "keyword.operator.optional.rivel", "match": "\\?" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.section.block.begin.rivel", "match": "\\{" },
        { "name": "punctuation.section.block.end.rivel", "match": "\\}" },
        { "name": "punctuation.section.group.begin.rivel", "match": "\\(" },
        { "name": "punctuation.section.group.end.rivel", "match": "\\)" },
        { "name": "punctuation.section.brackets.begin.rivel", "match": "\\[" },
        { "name": "punctuation.section.brackets.end.rivel", "match": "\\]" },
        { "name": "punctuation.separator.comma.rivel", "match": "," },
        { "name": "punctuation.separator.colon.rivel", "match": ":" },
        { "name": "punctuation.terminator.statement.rivel", "match": ";" },
        { "name": "punctuation.accessor.rivel", "match": "\\." }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.definition.rivel",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=[ \\t]*:)"
        },
        {
          "name": "variable.other.rivel",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    }
  }
}
