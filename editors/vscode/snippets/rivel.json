{
  "Main function": {
    "prefix": "main",
    "body": ["func main() -> int {", "\t$0", "\treturn 0;", "}"],
    "description": "Program entry point"
  },
  "Function": {
    "prefix": "func",
    "body": ["func ${1:name}(${2:value}: ${3:int}) -> ${4:int} {", "\treturn ${0:value};", "}"],
    "description": "Function with a typed parameter and return value"
  },
  "Struct": {
    "prefix": "struct",
    "body": ["struct ${1:Player} {", "\t${2:name}: ${3:str};", "\t$0", "}"],
    "description": "Reference type with named fields"
  },
  "Method": {
    "prefix": "method",
    "body": ["func ${1:describe}(self) -> ${2:str} {", "\treturn ${0:self.name};", "}"],
    "description": "Method inside a struct"
  },
  "Range loop": {
    "prefix": "for",
    "body": ["for ${1:index} in ${2:0}..${3:10} {", "\t$0", "}"],
    "description": "For loop with an exclusive upper bound"
  },
  "Inclusive range loop": {
    "prefix": "fori",
    "body": ["for ${1:number} in ${2:1}..=${3:10} {", "\t$0", "}"],
    "description": "For loop including the upper bound"
  },
  "Collection loop": {
    "prefix": "foreach",
    "body": ["for ${1:item} in ${2:items} {", "\t$0", "}"],
    "description": "Iterate over a list or string"
  },
  "While loop": {
    "prefix": "while",
    "body": ["while ${1:condition} {", "\t$0", "}"],
    "description": "While loop"
  },
  "Conditional": {
    "prefix": "if",
    "body": ["if ${1:condition} {", "\t$0", "}"],
    "description": "Conditional block"
  },
  "Parse optional integer": {
    "prefix": "parseint",
    "body": ["${1:value} := int(${2:text});", "if ${1:value} != null {", "\t$0", "}"],
    "description": "Parse an integer and narrow its optional result"
  },
  "Interpolated output": {
    "prefix": "print",
    "body": "println(f\"${1:Value}: {${2:value}}\");$0",
    "description": "Print an interpolated string"
  }
}
