func classify(n: int) -> str {
    if n < 0 {
        return "negative";
    } else if n == 0 {
        return "zero";
    } else if n < 10 {
        return "small";
    } else {
        return "large";
    }
}

func main() -> int {
    println(classify(-3));
    println(classify(0));
    println(classify(7));
    println(classify(100));
    return 0;
}
