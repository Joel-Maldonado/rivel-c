struct Pair {
    a: str;
    b: list[int];
}

func main() -> int {
    keep := Pair(a: "keep", b: [1, 2, 3]);
    total := 0;
    i := 0;
    while i < 200000 {
        p := Pair(a: f"item {i}", b: [i, i + 1]);
        total += len(p.a) + p.b[1];
        i += 1;
    }
    println(total);
    println(keep.a);
    println(keep.b[2]);
    s := "";
    for k in 0..2000 { s += "x"; }
    println(len(s));
    return 0;
}
