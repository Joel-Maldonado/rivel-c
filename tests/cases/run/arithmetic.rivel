func main() -> int {
    println(7 / 2);
    println(-7 / 2);
    println(-7 % 2);
    println(7 % -2);
    println(2 + 3 * 4 - 1);
    println((2 + 3) * 4);
    println(10 - 2 - 3);
    println(2.5 * 2);
    println(1 / 4.0);
    println(1.0 / 0.0);
    println(7 & 3 | 8 ^ 1);
    println(1 << 10 >> 3);
    println(~0);
    println(-(-5));
    return 0;
}
