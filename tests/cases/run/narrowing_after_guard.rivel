func first_char(s: str?) -> str {
    if s == null {
        return "?";
    }
    return s[0];
}

func main() -> int {
    println(first_char("hello"));
    println(first_char(null));
    v: int? = 7;
    if v != null && v > 5 { println(v * 2); }
    if v == null || v < 0 { println("bad"); } else { println(v + 1); }
    return 0;
}
