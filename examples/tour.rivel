struct Node {
    value: int;
    next: Node?;

    func total(self) -> int {
        sum := self.value;
        cur := self.next;
        while cur != null {
            sum += cur.value;
            cur = cur.next;
        }
        return sum;
    }
}

struct Point {
    x: float;
    y: float;
    func length(self) -> float { return sqrt(self.x * self.x + self.y * self.y); }
}

LIMIT: int = 10 * 2 + 1;
GREETING := "hi" + " there";
RATIO: float = 3;
FLAG := true;

func fib(n: int) -> int {
    if n < 2 { return n; }
    return fib(n - 1) + fib(n - 2);
}

func find(node: Node?, target: int) -> Node? {
    cur := node;
    while cur != null && cur.value != target {
        cur = cur.next;
    }
    return cur;
}

func describe(n: Node?) -> str {
    if n == null {
        return "none";
    }
    return f"node {n.value} with total {n.total()}";
}

func main() -> int {
    tail := Node(value: 3, next: null);
    head := Node(value: 1, next: Node(value: 2, next: tail));
    p := Point(x: 3.0, y: 4.0);
    xs: list[int] = [];
    xs.append(head.total());
    xs.append(fib(10));
    ys := [1.5, 2, 3];
    words := "a,b,c".split(",");
    for w in words { print(w); }
    println("");
    count := 0;
    for i in 0..LIMIT { if i % 7 == 0 { continue; } if i > 15 { break; } count += 1; }
    total := 0;
    for c in GREETING { total += ord(c); }
    parsed := int("42") ?? -1;
    bad := int("nope") ?? -1;
    found := find(head, 2);
    if found != null {
        found.value = 20;
    }
    println(f"{describe(found)} {p.length()} {parsed} {bad} {len(xs)} {ys[0]} {count} {total}");
    println(head.value == 1 && tail.next == null && p == p && ys != [1.0] && FLAG);
    println(f"{-7 / 2} {-7 % 2} {7 / 2} {2.5 * 2} {RATIO} {1 == 1.0} {"x" < "y"}");
    println(f"{GREETING.upper()} {GREETING[0..2]} {GREETING.contains("there")} {"-".join(words)}");
    m := xs.pop();
    println(f"{m} {len(xs)} {max(3, 9)} {min(2.5, 1)} {abs(-4)} {str(1.0e21)} {str(0.1)}");
    for i in 1..=3 { print(i); }
    println("");
    n := 0;
    while true { n += 1; if n == 5 { break; } }
    println(n);
    return xs[0] - 4;
}
