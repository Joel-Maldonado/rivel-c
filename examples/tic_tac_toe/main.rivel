// A complete terminal game. Run with --help for modes and --self-test for checks.

struct Board {
    cells: list[int];
    history: list[int];

    func place(self, square: int, player: int) -> bool {
        if square < 0 || square >= 9 || player < 1 || player > 2 {
            return false;
        }
        if self.cells[square] != 0 {
            return false;
        }
        self.cells[square] = player;
        self.history.append(square);
        return true;
    }

    func undo(self) {
        square := self.history.pop();
        self.cells[square] = 0;
    }

    func empty_count(self) -> int {
        count := 0;
        for cell in self.cells {
            if cell == 0 {
                count += 1;
            }
        }
        return count;
    }

    func winner(self) -> int {
        for line in 0..3 {
            start := line * 3;
            row := self.cells[start];
            if row != 0 && row == self.cells[start + 1] && row == self.cells[start + 2] {
                return row;
            }
            column := self.cells[line];
            if column != 0 && column == self.cells[line + 3] && column == self.cells[line + 6] {
                return column;
            }
        }
        center := self.cells[4];
        if center != 0 {
            if center == self.cells[0] && center == self.cells[8] {
                return center;
            }
            if center == self.cells[2] && center == self.cells[6] {
                return center;
            }
        }
        return 0;
    }

    func label(self, square: int) -> str {
        cell := self.cells[square];
        if cell == 0 {
            return str(square + 1);
        }
        return mark(cell);
    }

    func draw(self) {
        println("");
        println("    +---+---+---+");
        for row in 0..3 {
            start := row * 3;
            println(f"    | {self.label(start)} | {self.label(start + 1)} | {self.label(start + 2)} |");
            println("    +---+---+---+");
        }
        println("");
    }
}

func new_board() -> Board {
    return Board(cells: [0, 0, 0, 0, 0, 0, 0, 0, 0], history: []);
}

func mark(player: int) -> str {
    if player == 1 {
        return "X";
    }
    return "O";
}

// Negamax: each player maximizes their own score. Alpha-beta bounds skip
// continuations that cannot improve the choice. Depth favors quicker wins.
func search(board: Board, player: int, depth: int, alpha: int, beta: int) -> int {
    winner := board.winner();
    if winner != 0 {
        if winner == player {
            return 10 - depth;
        }
        return depth - 10;
    }
    if board.empty_count() == 0 {
        return 0;
    }
    best := -100;
    for square in 0..9 {
        if board.cells[square] != 0 {
            continue;
        }
        board.cells[square] = player;
        score := -search(board, 3 - player, depth + 1, -beta, -alpha);
        board.cells[square] = 0;
        best = max(best, score);
        alpha = max(alpha, score);
        if alpha >= beta {
            break;
        }
    }
    return best;
}

func best_move(board: Board, player: int) -> int {
    if board.winner() != 0 || board.empty_count() == 0 {
        return -1;
    }
    best_square := -1;
    best_score := -100;
    // Prefer the center, then corners, when several moves are equally good.
    order := [4, 0, 2, 6, 8, 1, 3, 5, 7];
    for square in order {
        if board.cells[square] != 0 {
            continue;
        }
        board.cells[square] = player;
        score := -search(board, 3 - player, 1, -100, -best_score);
        board.cells[square] = 0;
        if score > best_score {
            best_score = score;
            best_square = square;
        }
    }
    return best_square;
}

func show_commands() {
    println("Enter a square from 1 to 9, using the board as a guide.");
    println("hint  suggest a move     undo  take back your last turn");
    println("help  show commands      quit  leave the game (q also works)");
}

func show_help() {
    println("Rivel Tic Tac Toe");
    println("Usage: tic_tac_toe [--two-player | --ai-first | --demo | --self-test]");
    println("");
    println("Default: you play X against the computer's O. X always goes first.");
    println("--two-player  Share the keyboard with a friend.");
    println("--ai-first    Play O; the computer opens as X.");
    println("--demo        Watch two perfect players finish a game.");
    println("--self-test   Check the rules and exhaustively verify the AI.");
    println("--help        Show this help.");
    println("");
    show_commands();
}

// Return 1/2 for an X/O win, 0 for a draw, or -1 if the player quits.
func play_round(computer: int, demo: bool) -> int {
    board := new_board();
    while board.winner() == 0 && board.empty_count() > 0 {
        board.draw();
        player := len(board.history) % 2 + 1;
        if demo || player == computer {
            square := best_move(board, player);
            assert(board.place(square, player));
            println(f"Computer {mark(player)} plays {square + 1}.");
            continue;
        }

        print(f"{mark(player)} move [1-9, hint, undo, help, quit] > ");
        input := read_line();
        if input == null {
            println("");
            return -1;
        }
        command := input.trim().lower();
        if command == "quit" || command == "q" {
            return -1;
        }
        if command == "help" {
            show_commands();
            continue;
        }
        if command == "hint" {
            println(f"Hint: play {best_move(board, player) + 1}.");
            continue;
        }
        if command == "undo" {
            count := 1;
            if computer != 0 {
                count = 2;
            }
            if len(board.history) < count {
                println("Nothing to undo yet.");
            } else {
                for _step in 0..count {
                    board.undo();
                }
                println("Undid your last turn.");
            }
            continue;
        }

        number := int(command);
        if number == null {
            println("Enter a number from 1 to 9.");
            continue;
        }
        if number < 1 || number > 9 {
            println("Enter a number from 1 to 9.");
            continue;
        }
        if !board.place(number - 1, player) {
            println("That square is occupied.");
        }
    }

    board.draw();
    result := board.winner();
    if result == 0 {
        println("It's a draw.");
    } else {
        println(f"{mark(result)} wins!");
    }
    return result;
}

// Try every legal opponent continuation while the AI follows its real policy.
// The same board is restored after every branch, just as it is in the search.
func verify_strategy(board: Board, player: int, computer: int) -> int {
    result := board.winner();
    assert(result != 3 - computer);
    if result != 0 || board.empty_count() == 0 {
        return 1;
    }
    if player == computer {
        square := best_move(board, player);
        assert(board.place(square, player));
        finished := verify_strategy(board, 3 - player, computer);
        board.undo();
        return finished;
    }
    finished := 0;
    for square in 0..9 {
        if board.cells[square] == 0 {
            assert(board.place(square, player));
            finished += verify_strategy(board, 3 - player, computer);
            board.undo();
        }
    }
    return finished;
}

func self_test() {
    board := new_board();
    assert(board.winner() == 0);
    assert(board.empty_count() == 9);
    assert(!board.place(-1, 1));
    assert(!board.place(9, 1));
    assert(!board.place(0, 0));
    assert(!board.place(0, 3));
    assert(board.place(0, 1));
    assert(!board.place(0, 2));
    board.undo();
    assert(board.empty_count() == 9 && len(board.history) == 0);

    lines := [[0, 1, 2], [3, 4, 5], [6, 7, 8], [0, 3, 6],
              [1, 4, 7], [2, 5, 8], [0, 4, 8], [2, 4, 6]];
    for player in 1..=2 {
        for line in lines {
            winning := new_board();
            for square in line {
                assert(winning.place(square, player));
            }
            assert(winning.winner() == player);
            assert(best_move(winning, 3 - player) == -1);
        }
    }

    win := Board(cells: [1, 1, 0, 2, 2, 0, 0, 0, 0], history: []);
    assert(best_move(win, 1) == 2);
    block := Board(cells: [1, 1, 0, 0, 2, 0, 0, 0, 0], history: []);
    assert(best_move(block, 2) == 2);
    assert(block.cells == [1, 1, 0, 0, 2, 0, 0, 0, 0]);
    draw := Board(cells: [1, 2, 1, 1, 2, 2, 2, 1, 1], history: []);
    assert(draw.winner() == 0 && draw.empty_count() == 0);
    assert(best_move(draw, 1) == -1);

    as_x := verify_strategy(board, 1, 1);
    assert(board.empty_count() == 9 && len(board.history) == 0);
    as_o := verify_strategy(board, 1, 2);
    assert(board.empty_count() == 9 && len(board.history) == 0);
    println(f"Self-test passed: rules, tactics, and {as_x + as_o} complete opponent continuations.");
    println(f"AI never loses: {as_x} games as X, {as_o} games as O.");
}

func main() -> int {
    two_player := false;
    ai_first := false;
    demo := false;
    check := false;
    for argument in args() {
        if argument == "--help" || argument == "-h" {
            show_help();
            return 0;
        } else if argument == "--two-player" {
            two_player = true;
        } else if argument == "--ai-first" {
            ai_first = true;
        } else if argument == "--demo" {
            demo = true;
        } else if argument == "--self-test" {
            check = true;
        } else {
            eprintln(f"Unknown option: {argument}. Use --help.");
            return 1;
        }
    }
    modes := 0;
    if two_player { modes += 1; }
    if ai_first { modes += 1; }
    if demo { modes += 1; }
    if check { modes += 1; }
    if modes > 1 {
        eprintln("Choose only one mode. Use --help.");
        return 1;
    }
    if check {
        self_test();
        return 0;
    }

    println("========================================");
    println("          R I V E L  /  X & O");
    println("========================================");
    if demo {
        println("DEMO / Computer X vs Computer O");
        play_round(0, true);
        return 0;
    }
    computer := 2;
    if two_player {
        computer = 0;
        println("TWO PLAYERS / X goes first");
    } else if ai_first {
        computer = 1;
        println("You: O / Computer: X / Computer goes first");
    } else {
        println("You: X / Computer: O / You go first");
    }
    show_commands();

    wins_x := 0;
    wins_o := 0;
    draws := 0;
    round := 1;
    while true {
        println(f"\nROUND {round}");
        result := play_round(computer, false);
        if result < 0 {
            break;
        }
        if result == 1 {
            wins_x += 1;
        } else if result == 2 {
            wins_o += 1;
        } else {
            draws += 1;
        }
        println(f"Score: X {wins_x} | O {wins_o} | Draws {draws}");
        print("Play another round? [y/N] > ");
        reply := read_line();
        if reply == null {
            println("");
            break;
        }
        answer := reply.trim().lower();
        if answer != "y" && answer != "yes" {
            break;
        }
        round += 1;
    }
    println("Thanks for playing.");
    return 0;
}
