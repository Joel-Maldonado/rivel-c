// Top-level constants show typed globals, inference, and string builtins.
const TITLE: String = "Rivel feature tour"
const TAGLINE: String = "small language, clear syntax"
const TITLE_SLICE: String = substr(TITLE, 6, 7)
const TITLE_WIDTH = len(TITLE)
const HAS_RIVEL = contains(TITLE, "Rivel")
const LOOKS_POLISHED = starts_with(TAGLINE, "small") and ends_with(TAGLINE, "syntax")

// Structs let related values travel together with clear field names.
struct Stats {
    total: Int
    average: Double
    tier: String
}

struct Profile {
    name: String 
    level: Int
    active: Bool
    stats: Stats
}

// Small helpers keep `main` readable and make the tour feel like real code.
fn section(name: String) -> String {
    return "== " + name + " =="
}

fn sum_inclusive(limit: Int) -> Int {
    // Mutable variable
    mut total = 0

    // Inclusive for loop
    for i in 1..=limit {
        total = total + i
    }

    return total
}

fn sum_exclusive(limit: Int) -> Int {
    mut total = 0

    // Exclusive for loop
    for i in 0..limit {
        total = total + i
    }

    return total
}

fn spin_until(limit: Int) -> Int {
    mut step: Int = 0
    mut total = 0

    while step < limit {
        total = total + step * 2
        step = step + 1
    }

    return total
}

fn mean(left: Int, right: Int) -> Double {
    return (left + right) / 2.0
}

fn tier_for(total: Int) -> String {
    if total >= 15 {
        return "expert"
    } elif total >= 8 {
        return "steady"
    } else {
        return "starter"
    }
}

fn build_stats(rounds: Int) -> Stats {
    const total = sum_inclusive(rounds)
    const average = total * 1.0 / rounds
    return Stats { total: total, average: average, tier: tier_for(total) }
}

fn make_profile(name: String, rounds: Int) -> Profile {
    return Profile {
        name: name,
        level: 1,
        active: false,
        stats: build_stats(rounds)
    }
}

fn promote(profile: Profile, bonus: Int) -> Profile {
    mut next = profile
    next.level = next.level + bonus
    next.active = next.level >= 2
    return next
}

fn summary(profile: Profile) -> String {
    if profile.active and profile.stats.total >= 10 {
        return profile.name + " looks ready"
    } elif profile.active {
        return profile.name + " is improving"
    } else {
        return profile.name + " is warming up"
    }
}

fn main() -> Int {
    println(section(TITLE))
    println(TAGLINE)
    print("slice from the title: ")
    println(TITLE_SLICE)
    println("title width: ${TITLE_WIDTH}")
    println("contains Rivel: ${HAS_RIVEL}")
    println("starts and ends well: ${LOOKS_POLISHED}")

    println(section("loops and numbers"))
    const inclusive = sum_inclusive(5)
    const exclusive = sum_exclusive(5)
    const spun = spin_until(4)
    const blended = mean(inclusive, exclusive + spun)
    print("inclusive for total: ")
    println(inclusive)
    println("exclusive for total: ${exclusive}")
    println("while total: ${spun}")
    println("double mean: ${blended}")

    println(section("structs and functions"))
    const rookie = make_profile("Nova", 4)
    const upgraded = promote(rookie, 2)
    println("name: ${upgraded.name}")
    println("level: ${upgraded.level}")
    println("active: ${upgraded.active}")
    println("tier: ${upgraded.stats.tier}")
    println("total: ${upgraded.stats.total}")
    println("average: ${upgraded.stats.average}")
    println("summary: ${summary(upgraded)}")

    return 0
}
