const GREETING: String = "hello" + " world"
const HAS_WORLD: Bool = contains(GREETING, "world")
const HAS_PREFIX: Bool = starts_with(GREETING, "hello")
const HAS_SUFFIX: Bool = ends_with(GREETING, "world")

fn decorate(value: String) -> String {
    return value + "!"
}

fn main() -> Int {
    const tail = substr(GREETING, 6, 5)
    println(GREETING)
    println(tail)
    println(HAS_WORLD)
    println(HAS_PREFIX)
    println(HAS_SUFFIX)
    println(decorate(tail))
    return len(tail)
}
